System OpenCalls "Open Calls Artist Management System" id "opencalls" @product {
  Container WebApp "Single Page Application & Frontend UI" id "opencalls.web" @frontend {
    Module Shell "Main UI shell, routing, layouts, and styles" id "opencalls.web.shell" {
      path ["./index.html", "./Main.js"]
    }
    Module InboxView "Open calls directory, inbox table, filtering, and row menus" id "opencalls.web.inbox" {
      path ["./Part1_Inbox.js"]
    }
    Module ArtistsView "Artist pipelines, stage tracking, and submissions" id "opencalls.web.artists" {
      path ["./Part2_Artists.js"]
    }
    Module DashboardView "Overview dashboard, focus queue, and metric cards" id "opencalls.web.dashboard" {
      path ["./Part2_Dashboard.js"]
    }
    Module DocsView "Document review sheet, dossier inspector, and approvals" id "opencalls.web.docs" {
      path ["./Part2_Docs.js"]
    }
  }

  Container Services "Core Domain Services & Integrations" id "opencalls.services" @backend {
    Module Auth "Authentication, session storage, and domain access control" id "opencalls.services.auth" {
      path ["./Auth.js"]
    }
    Module AI "Flyer parser, intelligent data extraction, and email generator" id "opencalls.services.ai" {
      path ["./AI.js"]
    }
    Module Applications "Application lifecycle, statuses, and custom field tracking" id "opencalls.services.applications" {
      path ["./Applications.js", "./Fields.js", "./Part2_Lifecycle.js"]
    }
    Module Calendar "Google Calendar event generation and sync" id "opencalls.services.calendar" {
      path ["./Calendar.js"]
    }
    Module Documents "Google Drive and Google Docs integration" id "opencalls.services.documents" {
      path ["./Documents.js"]
    }
    Module Reminders "Deadline alerts and reminder notifications" id "opencalls.services.reminders" {
      path ["./Reminders.js", "./Alerts.js"]
    }
    Module Reports "Institutional impact analytics and export reporting" id "opencalls.services.reports" {
      path ["./Reports.js"]
    }
    Module Config "Runtime configuration, initial artist seed data, and taxonomy" id "opencalls.services.config" {
      path ["./Config.js", "./Categories.js", "./Utils.js"]
    }
  }
}

opencalls.web.shell -> opencalls.services.config "Loads runtime config and categories"
opencalls.web.shell -> opencalls.services.auth "Enforces user session"
opencalls.web.inbox -> opencalls.services.ai "Calls flyer intake extraction"
opencalls.web.artists -> opencalls.services.documents "Connects artist dossiers and Google Docs"
opencalls.web.dashboard -> opencalls.services.reminders "Displays active deadline alerts"
opencalls.web.dashboard -> opencalls.services.reports "Renders metrics"
